    "from dotenv import load_dotenv\n",
    "from langchain_groq import ChatGroq\n",
    "\n",
    "load_dotenv()\n",
    "\n",
    "llm = ChatGroq(model=\"llama-3.3-70b-versatile\")\n",
    "response = llm.invoke(\"Merhaba, kendini tanıt.\")\n",
    "print(response.content)"
   ]
  }
